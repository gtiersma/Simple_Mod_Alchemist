<brls:Box
    width="720px"
    height="600px"
    axis="column"
    paddingLeft="48px"
    paddingRight="48px"
    paddingTop="16px"
    paddingBottom="16px">

    <brls:Box
        width="auto"
        height="auto"
        alignItems="center"
        paddingTop="12px"
        paddingBottom="15px">
        <brls:Label
            id="title"
            width="auto"
            height="auto"
            maxWidth="60%"
            fontSize="24"
            singleLine="true"
            animated="true"/>
        <brls:Label
            width="auto"
            height="auto"
            marginLeft="20px"
            fontSize="16"
            horizontalAlign="right"
            text="Set how likely each mod is to get picked at random."/>
    </brls:Box>

    
    <brls:Rectangle
        width="auto"
        height="2px"
        color="@theme/brls/sidebar/separator"/>

    <brls:Box
        width="auto"
        height="auto"
        grow="1">
        <brls:RecyclerFrame
          id="list"
          width="100%"
          height="auto"/>
    </brls:Box>

</brls:Box>