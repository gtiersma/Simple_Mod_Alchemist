<brls:Box
    width="720px"
    height="660px"
    axis="column"
    paddingLeft="36px"
    paddingRight="36px"
    paddingTop="16px"
    paddingBottom="16px">

    <brls:Box
        width="100%"
        height="auto"
        justifyContent="spaceBetween"
        alignItems="baseline"
        paddingTop="12px"
        paddingBottom="16px">
        <brls:Label
            id="title"
            width="auto"
            height="auto"
            maxWidth="60%"
            fontSize="24"
            singleLine="true"
            animated="true"/>
        <brls:Label
            width="auto"
            height="auto"
            marginLeft="20px"
            fontSize="16"
            horizontalAlign="right"
            text="Set how likely each mod is to get picked at random."/>
    </brls:Box>

    <brls:Box
        width="100%"
        height="auto"
        paddingTop="8px"
        paddingBottom="6px"
        marginBottom="10px"
        lineTop="2px"
        lineBottom="2px"
        lineColor="#D0D0D0"
        grow="1">
        <brls:ScrollingFrame
            width="auto"
            height="auto"
            grow="1">
            <brls:Box
                id="list"
                width="auto"
                height="auto"
                axis="column"
            />
        </brls:ScrollingFrame>
    </brls:Box>

</brls:Box>